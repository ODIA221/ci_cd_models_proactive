          "query": "label_values(rcaeval_container_memory_usage_bytes{run=\"$run\"}, service)",
          "refId": "svc"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
